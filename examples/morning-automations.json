[
  {
    "id": "tokyu_bus_morning_start",
    "alias": "バス 平日朝8時に表示",
    "mode": "single",
    "triggers": [
      {
        "trigger": "time",
        "at": "08:00:00"
      },
      {
        "trigger": "homeassistant",
        "event": "start"
      }
    ],
    "conditions": [
      {
        "condition": "template",
        "value_template": "{{ now().weekday() < 5 and today_at('08:00') <= now() < today_at('10:00') }}"
      }
    ],
    "actions": [
      {
        "action": "script.turn_on",
        "target": {
          "entity_id": "script.tokyu_bus_live_morning"
        }
      }
    ]
  },
  {
    "id": "tokyu_bus_morning_end",
    "alias": "バス 朝10時に表示終了",
    "mode": "single",
    "triggers": [
      {
        "trigger": "time",
        "at": "10:00:00"
      },
      {
        "trigger": "homeassistant",
        "event": "start"
      }
    ],
    "conditions": [
      {
        "condition": "template",
        "value_template": "{{ not (now().weekday() < 5 and today_at('08:00') <= now() < today_at('10:00')) }}"
      }
    ],
    "actions": [
      {
        "action": "script.turn_off",
        "target": {
          "entity_id": "script.tokyu_bus_live_morning"
        }
      },
      {
        "action": "notify.mobile_app_YOUR_DEVICE",
        "data": {
          "message": "clear_notification",
          "data": {
            "tag": "tokyu_bus_morning"
          }
        }
      }
    ]
  }
]
